# --- Server Bootstrap ---
HOST=0.0.0.0
PORT=8181
APP_ENV=development

# --- Nacos Configuration (Bootstrap) ---
# Nacos 服务器地址
NACOS_SERVER_ADDR=127.0.0.1:8848
# Nacos 命名空间 ID
NACOS_NAMESPACE=
# Nacos 分组
NACOS_GROUP=DEFAULT_GROUP
# Nacos 认证信息
NACOS_USERNAME=nacos
NACOS_PASSWORD=nacos

# --- Service Registration ---
# 本服务名
SERVICE_NAME=python-agent
# 本服务对外 IP (可选，通常自动检测)
# SERVICE_IP=127.0.0.1
# Nacos 心跳间隔 (秒)
NACOS_HEARTBEAT_INTERVAL=30

# --- Discovery & MCP ---
# Nacos 中网关服务的名字
NACOS_GATEWAY_SERVICE_NAME=gateway
# Nacos 中 Java 后端服务的名字 (用于 MCP 调用)
NACOS_JAVA_SERVICE_NAME=ai-langchain4j
# Brave Search MCP 本地路径 (可选，用于 stdio 模式)
# MCP_BRAVE_PATH=

# --- Security ---
# JWT 秘钥 (必须包含至少 256 位，用于 Token 校验)
JWT_SECRET=your-secure-jwt-secret-at-least-32-chars-long

# --- Fallback Config (建议通过 Nacos 下发，以下仅供 Nacos 不可用时通过本地启动) ---
# PG_HOST=localhost
# PG_PORT=5432
# PG_USER=postgres
# PG_PASSWORD=postgres
# PG_DB=postgres

# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o
# LLM_API_KEY=sk-xxxx
